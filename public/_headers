# Formato compatible con Netlify y Cloudflare Pages (otros hostings lo ignoran).
# Los archivos de /assets llevan hash en el nombre, así que pueden cachearse para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
